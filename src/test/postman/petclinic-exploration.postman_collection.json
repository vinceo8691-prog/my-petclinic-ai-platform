					"response": []
				},
				{
					"name": "List Owners (Paginated v2)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v2/owners?page=0&size=5",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "v2", "owners" ],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "5" },
								{ "key": "lastName", "value": "", "disabled": true }
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code < 300) {",
									"    const json = pm.response.json();",
									"    if (json.id !== undefined) {",
									"        pm.environment.set('ownerId', json.id);",
									"    }",
									"}",
									"pm.test('Owner created', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"George\",\n  \"lastName\": \"Franklin\",\n  \"address\": \"110 W. Liberty St.\",\n  \"city\": \"Madison\",\n  \"telephone\": \"6085551023\"\n}",
